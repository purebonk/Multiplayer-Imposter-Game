# Copy to .env for local overrides, or set these in Render's dashboard.
# Every value below is optional — the defaults in config.py are what the app
# uses if a variable is unset.
#
# NOTE: there are no secrets in this project. Jikan and AniList are both
# keyless, and neither is called during normal gameplay (only by the offline
# build scripts, plus one optional post-game lookup). Everything here is a
# deployment knob, not a credential.

# --- deployment -------------------------------------------------------------

# Set to 1 ONLY when running behind a trusted reverse proxy (Render does this).
# When on, the left-most X-Forwarded-For entry is treated as the real client IP.
# Leave off locally: a client can send that header themselves, so trusting it
# without a proxy in front would let anyone spoof their way past per-IP limits.
TRUST_PROXY=0

# Comma-separated origins allowed to call the HTTP API from a browser.
# In production set this to your Render URL, e.g.
#   ALLOWED_ORIGINS=https://anime-imposter.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# CORS does not cover WebSockets. Turn this on in production to reject socket
# connections whose Origin header isn't in ALLOWED_ORIGINS. Off locally so raw
# socket tooling and tests still work.
ENFORCE_WS_ORIGIN=0

# Render injects PORT itself; this is only for local runs.
PORT=8000

# --- capacity (sized for Render's 512MB free tier) --------------------------

MAX_ROOMS=300
MAX_PLAYERS_PER_ROOM=20
EMPTY_ROOM_TTL_SECONDS=600
IDLE_ROOM_TTL_SECONDS=7200
ROOM_SWEEP_INTERVAL_SECONDS=120

# --- rate limits ------------------------------------------------------------
# All per-IP values assume an IP may be a whole household, dorm floor, or
# hotspot of players. Raise rather than lower if real groups get blocked.

ROOM_CREATE_PER_MINUTE=10
ROOM_CREATE_PER_15MIN=30
FAILED_JOIN_PER_MINUTE=30
API_PER_MINUTE=120
DETAILS_PER_MINUTE=20

# Per-connection (not per-IP), so shared-IP groups are never penalised.
WS_BURST=40
WS_REFILL_PER_SECOND=12
WS_FLOOD_STRIKES=60

MAX_CONNECTIONS_PER_IP=50

# --- input limits -----------------------------------------------------------

MAX_NAME_LENGTH=20
MAX_HINT_LENGTH=40
MAX_GUESS_LENGTH=60
MAX_WS_MESSAGE_BYTES=4096
